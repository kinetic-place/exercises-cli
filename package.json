{
  "name": "exercises-cli",
  "version": "1.2.0",
  "description": "908 fitness exercises with step-by-step guides in your terminal and in your AI assistant (MCP server). Search, filter, and export. Offline-ready, multilingual (EN/ES).",
  "license": "MIT",
  "author": "Kinetic.place",
  "homepage": "https://kinetic.place",
  "repository": {
    "type": "git",
    "url": "https://github.com/kinetic-place/exercises-cli"
  },
  "keywords": [
    "exercises",
    "fitness",
    "gym",
    "workout",
    "cli",
    "muscle",
    "strength",
    "exercise-database",
    "exercise-api",
    "offline",
    "mcp",
    "mcp-server",
    "model-context-protocol"
  ],
  "bin": {
    "exercises": "./dist/cli.js",
    "exercises-cli": "./dist/cli.js",
    "exercises-mcp": "./dist/mcp.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup && node scripts/copy-data.mjs --dist",
    "dev": "node scripts/copy-data.mjs && tsx src/cli.ts",
    "prepublishOnly": "yarn build"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.7.0",
    "zod": "^4.3.6"
  },
  "dependencies": {
    "cli-table3": "^0.6.5",
    "commander": "^13.0.0"
  }
}
